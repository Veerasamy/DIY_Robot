<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_interface</name>
  <version>1.0.0</version>
  <description>
    Thin wrapper/config around the vendored rplidar_ros driver: republishes
    a cleaned /scan (blind-spot masking, range clamping, frame_id
    normalization) for obstacle_detection.
  </description>
  <maintainer email="maintainer@example.com">autonomous_rc</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <!-- Vendored community driver, not built from this workspace. Install
       from apt/rosdep or clone into src/ per the package README. -->
  <exec_depend>rplidar_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
