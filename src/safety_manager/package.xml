<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>safety_manager</name>
  <version>1.0.0</version>
  <description>
    Hardware E-Stop bridge (ESP32/radio UART link) and vehicle safety state
    machine (NORMAL/AVOID/BRAKE/REVERSE/RECOVER/EMERGENCY_STOP) for the
    SCRT10 autonomous race car. This node is the sole owner of the actuator
    UART link and has final authority to force EMERGENCY_STOP.
  </description>
  <maintainer email="maintainer@example.com">autonomous_rc</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>builtin_interfaces</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
