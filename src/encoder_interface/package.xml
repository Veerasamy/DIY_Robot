<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>encoder_interface</name>
  <version>1.0.0</version>
  <description>
    GPIO quadrature tick counter for the SCRT10's dual-Hall wheel encoder,
    publishing /encoder/ticks and /encoder/velocity_mps consumed by
    sensor_fusion's EKF.
  </description>
  <maintainer email="maintainer@example.com">autonomous_rc</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>pkg-config</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
